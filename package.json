{
  "name": "@jhgaylor/me-mcp",
  "version": "1.3.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "views",
    "public",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "start:web": "node dist/index.js --transport=http",
    "dev": "nodemon --watch src --ext ts --exec 'npm run build && npm start'",
    "dev:web": "nodemon --watch src --ext ts --exec 'npm run build && npm run start:web'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "me-mcp": "dist/index.js"
  },
  "author": "Jake Gaylor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhgaylor/ai-jakegaylor-com.git"
  },
  "license": "MIT",
  "description": "An Express + TypeScript server that makes Jake Gaylor legible to AI systems: a webpage, llms.txt, an MCP server, and an A2A agent over the same resume.",
  "dependencies": {
    "@a2a-js/sdk": "^1.0.1",
    "@jhgaylor/candidate-mcp-server": "~1.4.1",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.17.0",
    "cheerio": "^1.0.0",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-mcp-handler": "^0.1.1",
    "express-nunjucks": "^3.1.2",
    "nodemailer": "^9.0.3",
    "nunjucks": "^3.2.4",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.1",
    "@types/nunjucks": "^3.2.6",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.0.3",
    "typescript": "^5.8.3"
  }
}
